<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cobra">
	<xacro:property name="wheel_mass"   value="0.23126"/>
	<xacro:property name="wheel_width"  value="0.02000"/>
	<xacro:property name="wheel_radius" value="0.03726"/>

	<xacro:property name="body_mass"   value="2.375"/>
	<xacro:property name="body_width"  value="0.179"/>
	<xacro:property name="body_height" value="0.200"/>
	<xacro:property name="body_length" value="0.23525"/>
	<xacro:property name="body_center_z" value="${wheel_radius}"/>

	<xacro:property name="left_front_anchor"  value=" 0.0795  0.0770 ${wheel_radius}"/>
	<xacro:property name="left_rear_anchor"   value="-0.0795  0.0770 ${wheel_radius}"/>
	<xacro:property name="right_front_anchor" value=" 0.0795 -0.0770 ${wheel_radius}"/>
	<xacro:property name="right_rear_anchor"  value="-0.0795 -0.0770 ${wheel_radius}"/>

	<!-- ======================== Base link (robot body) ======================== -->
	<link name="base_footprint">
		<visual>
			<origin xyz="0 0 ${body_center_z}" rpy="3.14159 3.14159 -1.5708"/>
			<geometry>
				<mesh filename="package://description/meshes/cobra_body.dae" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>

		<collision>
			<origin xyz="0 0 ${body_center_z}" rpy="0 0 0"/>
			<geometry>
				<box size="${body_length} ${body_width} ${body_height}"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 ${body_center_z}" rpy="0 0 0"/>
			<mass value="${body_mass}"/>
			<inertia
				ixx="0.008411458333333333" ixy="0" ixz="0"
				iyy="0.017614583333333333" iyz="0"
				izz="0.011736458333333333"/>
		</inertial>
	</link>


	<!-- ======================== Base cam (robot camera) ======================== -->
	<!-- <link name="base_cam"/> -->
	<!-- <joint name="cam_joint" type="fixed"> -->
	<!-- 	<parent link="base_footprint"/> -->
	<!-- 	<child link="base_cam"/> -->
	<!-- 	<origin xyz="-0.094121 -0.00900 0.19138" rpy="0 0.34907 0"/> -->
	<!-- </joint> -->

	<!-- ======================== Base scan (lidar) ======================== -->
	<link name="base_scan"/>
	<joint name="scan_joint" type="fixed">
		<parent link="base_footprint"/>
		<child link="base_scan"/>
		<origin xyz="0.068376 -0.00385 0.11971" rpy="0 0 0"/>
	</joint>

	<!-- ======================== Wheel template ======================== -->
	<xacro:macro name="wheel" params="name side">
		<link name="${name}">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://description/meshes/cobra_wheel_${side}.stl" scale="0.001 0.001 0.001"/>
				</geometry>
				<material name="wheel_material">
					<color rgba="0.05 0.05 0.05 1.0"/>
				</material>
			</visual>

			<collision>
				<origin xyz="0 0 0" rpy="1.5708 0 0"/>
				<geometry>
					<cylinder radius="${wheel_radius}" length="${wheel_width}"/>
				</geometry>
			</collision>

			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<mass value="${wheel_mass}"/>
				<inertia
					ixx="8.973285416666667e-05" ixy="0" ixz="0"
					iyy="1.6373237499999998e-04" iyz="0"
					izz="8.973285416666667e-05"/>
			</inertial>
		</link>
	</xacro:macro>

	<xacro:macro name="wheel_joint" params="jname child xyz rpy:='0 0 0'">
		<joint name="${jname}" type="continuous">
			<parent link="base_footprint"/>
			<child  link="${child}"/>
			<origin xyz="${xyz}" rpy="${rpy}"/>
			<axis xyz="0 1 0"/>
		</joint>
	</xacro:macro>

	<!-- ======================== Wheels ======================== -->
	<xacro:wheel name="left_rear_wheel" side="left"/>
	<xacro:wheel_joint jname="left_rear_wheel_joint" child="left_rear_wheel" xyz="${left_rear_anchor}" rpy="0 -1.5708 3.14159"/>

	<xacro:wheel name="left_front_wheel" side="left"/>
	<xacro:wheel_joint jname="left_front_wheel_joint" child="left_front_wheel" xyz="${left_front_anchor}" rpy="0 -1.5708 3.14159"/>

	<xacro:wheel name="right_rear_wheel" side="right"/>
	<xacro:wheel_joint jname="right_rear_wheel_joint" child="right_rear_wheel" xyz="${right_rear_anchor}" rpy="0 0 0"/>

	<xacro:wheel name="right_front_wheel" side="right"/>
	<xacro:wheel_joint jname="right_front_wheel_joint" child="right_front_wheel" xyz="${right_front_anchor}" rpy="0 0 0"/>
</robot>
