<launch>
  <!-- Main launch file for Cobra robot -->
  
  <!-- Arguments -->
  <arg name="use_hardware" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="use_teleop" default="true"/>
  <arg name="use_lidar" default="true"/>
  <arg name="port" default="/dev/ttyACM1"/>
  <arg name="baud" default="115200"/>
  <arg name="lidar_port" default="/dev/ttyUSB0"/>
  <arg name="lidar_baud" default="230400"/>
  
  <!-- Robot description -->
  <arg name="urdf_file" default="$(find cobra_description)/urdf/cobra.urdf.xacro"/>
  <param name="robot_description" command="$(find xacro)/xacro $(arg urdf_file)"/>

  <!-- State publishers -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" output="screen"/>

  <!-- Load parameter files -->
  <rosparam file="$(find cobra_bringup)/config/cobra_params.yaml" command="load"/>
  <rosparam file="$(find cobra_hardware)/config/controllers.yaml" command="load"/>
  <rosparam file="$(find cobra_bringup)/config/hardware.yaml" command="load"/>

  <!-- Hardware interface (if enabled) -->
  <group if="$(arg use_hardware)">
    <node pkg="cobra_hardware" type="cobra_hardware" name="cobra_hardware" output="screen">
      <param name="port" value="$(arg port)"/>
      <param name="baud" value="$(arg baud)"/>
    </node>
  </group>

  <!-- Controller manager spawner -->
  <node pkg="controller_manager" type="spawner" name="controller_spawner"
        args="joint_state_controller cobra_base_controller" output="screen" />

  <!-- Teleop (if enabled) -->
  <group if="$(arg use_teleop)">
    <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="teleop" output="screen">
      <remap from="cmd_vel" to="/cobra_base_controller/cmd_vel"/>
    </node>
  </group>

  <!-- LiDAR (if enabled) -->
  <group if="$(arg use_lidar)">
    <rosparam file="$(find cobra_bringup)/config/lidar.yaml" command="load"/>
    <include file="$(find ldlidar_stl_ros)/launch/ld19.launch">
      <arg name="port_name" value="$(arg lidar_port)"/>
      <arg name="port_baudrate" value="$(arg lidar_baud)"/>
    </include>
  </group>

  <!-- RViz (if enabled) -->
  <group if="$(arg use_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find cobra_bringup)/rviz/cobra.rviz" output="screen" required="false"/>
  </group>
</launch>
