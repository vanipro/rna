<launch>
  <!-- Test controllers launch file -->
  
  <!-- Load controller configuration -->
  <rosparam file="$(find cobra_hardware)/config/controllers.yaml" command="load"/>
  
  <!-- Start controller manager -->
  <node pkg="controller_manager" type="controller_manager" name="controller_manager" 
        output="screen" respawn="false" />
  
  <!-- Load controllers -->
  <node pkg="controller_manager" type="spawner" name="controller_spawner"
        args="joint_state_controller cobra_base_controller" output="screen" />
  
  <!-- Test velocity publishing -->
  <node pkg="rostopic" type="rostopic" name="test_pub" 
        args="pub /cobra_base_controller/cmd_vel geometry_msgs/Twist 'linear: {x: 0.5, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}'" 
        output="screen" />
        
</launch>
