<?xml version="1.0"?>
<launch>
  <!-- Data Recording Launch File for Cobra Robot -->
  
  <!-- Arguments -->
  <arg name="bag_name" default="cobra_data_$(anon record)"/>
  <arg name="duration" default=""/>
  <arg name="topics" default=""/>
  <arg name="record_all" default="false"/>
  <arg name="bags_dir" default="$(env HOME)/rosbags"/>
  <arg name="verbose" default="false"/>
  
  <!-- Create bags directory -->
  <param name="bags_directory" value="$(arg bags_dir)"/>
  
  <!-- Default topics for Cobra robot recording -->
  <arg name="default_topics" value="/scan /tf /tf_static /joint_states /cobra_base_controller/cmd_vel /cobra_base_controller/odom /cobra_base_controller/state /clock /rosout /rosout_agg"/>
  
  <!-- Determine which topics to record -->
  <arg name="topics_to_record" value="$(arg default_topics)" unless="$(arg record_all)"/>
  <arg name="topics_to_record" value="" if="$(arg record_all)"/>
  
  <!-- Override with custom topics if provided -->
  <arg name="topics_to_record" value="$(arg topics)" if="$(eval arg('topics') != '')"/>
  
  <!-- Recording node -->
  <node pkg="rosbag" type="record" name="cobra_recorder" output="screen"
        args="-O $(arg bags_dir)/$(arg bag_name).bag $(arg topics_to_record)"
        if="$(eval arg('topics') != '' or not arg('record_all'))">
    <param name="duration" value="$(arg duration)" if="$(eval arg('duration') != '')"/>
  </node>
  
  <!-- Recording node for all topics -->
  <node pkg="rosbag" type="record" name="cobra_recorder_all" output="screen"
        args="-O $(arg bags_dir)/$(arg bag_name).bag -a"
        if="$(arg record_all)">
    <param name="duration" value="$(arg duration)" if="$(eval arg('duration') != '')"/>
  </node>
  
  <!-- Display recording information -->
  <node pkg="rostopic" type="rostopic" name="recording_info" 
        args="echo -n1 /rosout" output="screen" required="false"/>
  
</launch>
