<launch>
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_frame" default="map" />
  <arg name="map_frame" default="world" />

  <arg name="initial_x" default="0.15" />
  <arg name="initial_y" default="0.15" />

  <node pkg="tf" type="static_transform_publisher" name="map_to_odom"
        args="$(arg initial_x) $(arg initial_y) 0 0 0 0 $(arg map_frame) $(arg odom_frame) 100" />

  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node" respawn="false" name="laser_matcher" output="screen">
    <remap from="/odom" to="/cobra/mobile_base_controller/odom" />
    <param name="fixed_frame" value="$(arg odom_frame)" />
    <param name="base_frame" value="$(arg base_frame)" />

    <param name="use_imu" value="false" />
    <param name="use_odom" value="true" />
    <param name="use_vel" value="false" />
    <param name="use_tf" value="false" />
    <param name="use_cloud_input" value="false" />

    <param name="publish_tf" value="true" />
    <param name="publish_pose" value="false" />
    <param name="publish_pose_stamped" value="false" />

    <param name="max_iterations" value="20" />
    <param name="max_correspondence_dist" value="0.15" />
    <param name="max_angular_correction_deg" value="7" />
    <param name="max_linear_correction" value="0.15" />
    <param name="epsilon_xy" value="0.01" />
    <param name="epsilon_theta" value="0.001" />
    <param name="outliers_maxPerc" value="0.9" />
  </node>

  <node pkg="grid_maze_map" type="grid_maze_map" respawn="false" name="mapper" output="screen">
    <param name="laser_topic" value="/scan" />
    <param name="point_weight" value="25" />
    <param name="fading_gradient" value="0.4" />
    <param name="debug_frequency" value="5" />
    <param name="update_frequency" value="10" />
    <param name="cell_size" value="0.3749" />
    <param name="max_segment_angle" value="5.0" />
    <param name="max_segment_distance" value="0.05" />
    <param name="min_segment_overlap" value="0.5" />
    <param name="global_frame" value="$(arg map_frame)" />
    <param name="resolution" value="0.01" />
    <param name="width" value="3.0" />
    <param name="height" value="1.5" />
  </node>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <param name="base_global_planner" value="navfn/NavfnROS" />

    <remap from="/cmd_vel" to="/cobra/mobile_base_controller/cmd_vel" />
    
    <rosparam file="$(find navigation)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find navigation)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find navigation)/param/local_costmap.yaml" command="load" />
    <rosparam file="$(find navigation)/param/global_costmap.yaml" command="load" />
    <rosparam file="$(find navigation)/param/move_base.yaml" command="load" />
    <rosparam file="$(find navigation)/param/local_planner.yaml" command="load" />
    <rosparam file="$(find navigation)/param/global_planner.yaml" command="load" />
  </node>
</launch>