<?xml version="1.0"?>
<package format="2">
  <name>bringup</name>
  <version>0.0.0</version>
  <description>The bringup package contains launch files and configuration for starting the Cobra robot system</description>

  <maintainer email="user@example.com">user</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  
  <!-- Dependencies for launch files -->
  <exec_depend>description</exec_depend>
  <exec_depend>hardware</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>ldlidar_stl_ros</exec_depend>
  <exec_depend>roslaunch</exec_depend>

  <export>
    <roslaunch>
      <roslaunch_auto/>
    </roslaunch>
  </export>
</package>
