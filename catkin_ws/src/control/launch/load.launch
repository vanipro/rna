<launch>
	<node pkg="control" type="controller" name="robo_hardware" output="screen">
        <rosparam command="load" file="$(find control)/config/hardware.yaml"/>
		<remap from="/cobra/mobile_base_controller/cmd_vel" to="/cmd_vel"/>
	</node>

    <include file="$(find ldlidar_stl_ros)/launch/ld19.launch">
        <rosparam command="load" file="$(find control)/config/lidar.yaml"/>
    </include>

    <rosparam command="load" file="$(find control)/config/ros_controllers.yaml"/>
    <node pkg="controller_manager" type="spawner" name="controller_manager" output="screen" 
          args="
                /cobra/mobile_base_controller
                /cobra/joint_state_controller">
    </node>

    <arg name="model" default="$(find description)/urdf/cobra.urdf.xacro"/>
    
    <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
</launch>